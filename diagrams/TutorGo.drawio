  <diagram name="Страница-1" id="NQ5rjz8QmHFHfAWACgqU">
    <mxGraphModel dx="3214" dy="2091" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users {\n        uuid id PK\n        string email UQ\n        string password_hash\n        enum role \&quot;admin, tutor, student\&quot;\n        string first_name\n        string last_name\n        string phone\n        string timezone\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    tutor_profiles {\n        uuid user_id PK, FK\n        text bio\n        string education\n        int experience_years\n        decimal hourly_rate\n        string currency\n        boolean is_verified\n        decimal rating_avg\n        int rating_count\n        datetime updated_at\n    }\n\n    tutor_documents {\n        uuid id PK\n        uuid tutor_id FK\n        string doc_type\n        string file_url\n        enum status \&quot;pending, approved, rejected\&quot;\n        uuid reviewed_by FK\n        datetime created_at\n    }\n\n    tutor_availability {\n        uuid id PK\n        uuid tutor_id FK\n        int weekday \&quot;0-6\&quot;\n        time start_time\n        time end_time\n    }\n\n    tutor_time_off {\n        uuid id PK\n        uuid tutor_id FK\n        datetime starts_at\n        datetime ends_at\n        string reason\n    }\n\n    subjects {\n        uuid id PK\n        uuid parent_id FK\n        string name\n        string slug UQ\n    }\n\n    tutor_subjects {\n        uuid tutor_id PK, FK\n        uuid subject_id PK, FK\n        string level\n        decimal price\n    }\n\n    favorites {\n        uuid student_id PK, FK\n        uuid tutor_id PK, FK\n        datetime created_at\n    }\n\n    bookings {\n        uuid id PK\n        uuid student_id FK\n        uuid tutor_id FK\n        uuid subject_id FK\n        datetime starts_at\n        datetime ends_at\n        enum format \&quot;online, offline\&quot;\n        enum status \&quot;pending, confirmed, completed, cancelled\&quot;\n        string meeting_url\n        decimal price\n        string cancel_reason\n        datetime created_at\n        datetime updated_at\n    }\n\n    payments {\n        uuid id PK\n        uuid booking_id FK\n        decimal amount\n        string currency\n        enum status \&quot;pending, success, failed, refunded\&quot;\n        string provider\n        string provider_txn_id UQ\n        datetime paid_at\n    }\n\n    payouts {\n        uuid id PK\n        uuid tutor_id FK\n        decimal amount\n        string currency\n        enum status \&quot;pending, processing, completed\&quot;\n        datetime processed_at\n        datetime created_at\n    }\n\n    reviews {\n        uuid id PK\n        uuid booking_id FK, UQ\n        uuid student_id FK\n        uuid tutor_id FK\n        int rating \&quot;1-5\&quot;\n        text comment\n        datetime created_at\n    }\n\n    notifications {\n        uuid id PK\n        uuid user_id FK\n        string type\n        jsonb payload\n        boolean is_read\n        datetime created_at\n    }\n\n    messages {\n        uuid id PK\n        uuid sender_id FK\n        uuid receiver_id FK\n        uuid booking_id FK\n        text content\n        boolean is_read\n        datetime created_at\n    }\n\n    %% Связи (Relationships)\n    users ||--o| tutor_profiles : \&quot;1:1 is a\&quot;\n    users ||--o{ notifications : \&quot;gets\&quot;\n    users ||--o{ tutor_documents : \&quot;reviews (admin)\&quot;\n    \n    tutor_profiles ||--o{ tutor_documents : \&quot;has\&quot;\n    tutor_profiles ||--o{ tutor_availability : \&quot;works\&quot;\n    tutor_profiles ||--o{ tutor_time_off : \&quot;blocks\&quot;\n    tutor_profiles ||--o{ tutor_subjects : \&quot;teaches\&quot;\n    tutor_profiles ||--o{ payouts : \&quot;receives\&quot;\n    \n    subjects ||--o{ subjects : \&quot;parent\&quot;\n    subjects ||--o{ tutor_subjects : \&quot;saved in\&quot;\n    \n    users ||--o{ favorites : \&quot;saves (student)\&quot;\n    tutor_profiles ||--o{ favorites : \&quot;favorited by\&quot;\n    \n    users ||--o{ bookings : \&quot;books (student)\&quot;\n    tutor_profiles ||--o{ bookings : \&quot;gives lesson\&quot;\n    subjects ||--o{ bookings : \&quot;about\&quot;\n    \n    bookings ||--o| payments : \&quot;paid by\&quot;\n    bookings ||--o| reviews : \&quot;reviewed in\&quot;\n    \n    users ||--o{ reviews : \&quot;writes (student)\&quot;\n    tutor_profiles ||--o{ reviews : \&quot;receives\&quot;\n    \n    users ||--o{ messages : \&quot;sends\&quot;\n    users ||--o{ messages : \&quot;receives\&quot;\n    bookings ||--o{ messages : \&quot;context\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mFSDlFf1AgSW9EZgi64r-2">
