<mxfile host="app.diagrams.net"><diagram name="TutorGo component diagram — proposed modular monolith"><mxGraphModel page="1" pageWidth="1400" pageHeight="840"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="React SPA&#xa;Student, tutor, admin&#xa;HTTPS / JSON" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="30" y="305" width="220" height="150" as="geometry"/></mxCell><mxCell id="api" value="NestJS API boundary&#xa;Auth and role guards&#xa;Input validation" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="360" y="305" width="230" height="150" as="geometry"/></mxCell><mxCell id="profiles" value="Profiles and Catalog&#xa;Verification, subjects&#xa;Search and reviews" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="300" height="130" as="geometry"/></mxCell><mxCell id="booking" value="Availability and Booking&#xa;Slots, holds, acceptance&#xa;Payment orchestration" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="300" height="130" as="geometry"/></mxCell><mxCell id="events" value="Messaging and Events&#xa;Booking participants&#xa;Notifications / payouts" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="700" y="530" width="300" height="130" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL&#xa;Relations, constraints&#xa;Transactions" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#EDF3FF;strokeColor=#DCE3EF;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="250" height="130" as="geometry"/></mxCell><mxCell id="files" value="Private file storage&#xa;Protected documents&#xa;Access-contr